// Author: Jorge Agra
//
// A port of Mario Carneiro's MM1 `tauto` tactic
// (https://github.com/GinoGiotto/mm1_tactics, tauto/tauto.mm1) to rmm, on set.mm.
// It proves closed classical propositional tautologies over -> -. /\ \/ <-> -/\ -\/
// \/_ T. F. if- hadd cadd, plus set.mm's 3-ary /\ and \/.
// Inference rules (theorems with $e hypotheses) are not supported.
//
// The MM1 tactic proves `G -> t -> R` (proveN) and `G -> t \/ R` (proveP), where G
// is a conjunction of literals assumed so far (starting at T.) and R a chain of
// remaining goals (ending at F.). This tactic unifies them and writes proveP as
// `G -> -. t -> R` instead of `G -> t \/ R`, so each match clause uses existing
// set.mm theorems.

load "file3.mm"

// Proves `G -> c` when the literal c is one of the conjuncts of G.
tactics tauto_member ()
{ try
	{ apply ~simpr }
	{ apply ~adantr { use tauto_member } }
}

// Proves `( G -> ( t -> R ) )` by the content of t; R is F. or another `( t' -> R' )`.
tactics tauto_step ()
{ match goal
	// Cases of MM1's proveP
	$ ( &W1 -> ( -. -. &W2 -> &W9 ) ) $
	{ apply ~syl5 { apply ~notnotr } { use tauto_step } with ~wps $ &W2 $ }
	$ ( &W1 -> ( -. ( &W2 -> &W3 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpri { apply ~annim } } { apply ~impd { use tauto_step } } with ~wps $ ( &W2 /\ -. &W3 ) $ }
	$ ( &W1 -> ( -. ( &W2 /\ &W3 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~ianor } } { apply ~jaod { use tauto_step } { use tauto_step } } with ~wps $ ( -. &W2 \/ -. &W3 ) $ }
	$ ( &W1 -> ( -. ( &W2 \/ &W3 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~ioran } } { apply ~impd { use tauto_step } } with ~wps $ ( -. &W2 /\ -. &W3 ) $ }
	$ ( &W1 -> ( -. ( &W2 <-> &W3 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~xor } } { apply ~jaod { apply ~impd { use tauto_step } } { apply ~impd { use tauto_step } } } with ~wps $ ( ( &W2 /\ -. &W3 ) \/ ( &W3 /\ -. &W2 ) ) $ }
	$ ( &W1 -> ( -. ( &W2 -/\ &W3 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~notbii { apply ~df-nan } } } { apply ~syl5 { apply ~notnotr } { apply ~impd { use tauto_step } } with ~wps $ ( &W2 /\ &W3 ) $ } with ~wps $ -. -. ( &W2 /\ &W3 ) $ }
	$ ( &W1 -> ( -. ( &W2 -\/ &W3 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~notbii { apply ~df-nor } } } { apply ~syl5 { apply ~notnotr } { apply ~jaod { use tauto_step } { use tauto_step } } with ~wps $ ( &W2 \/ &W3 ) $ } with ~wps $ -. -. ( &W2 \/ &W3 ) $ }
	$ ( &W1 -> ( -. ( &W2 \/_ &W3 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpri { apply ~xnor } } { apply ~syl5 { apply ~biimpi { apply ~dfbi3 } } { apply ~jaod { apply ~impd { use tauto_step } } { apply ~impd { use tauto_step } } } with ~wps $ ( ( &W2 /\ &W3 ) \/ ( -. &W2 /\ -. &W3 ) ) $ } with ~wps $ ( &W2 <-> &W3 ) $ }
	$ ( &W1 -> ( -. ( &W2 /\ &W3 /\ &W4 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~notbii { apply ~df-3an } } } { use tauto_step } with ~wps $ -. ( ( &W2 /\ &W3 ) /\ &W4 ) $ }
	$ ( &W1 -> ( -. ( &W2 \/ &W3 \/ &W4 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~notbii { apply ~df-3or } } } { use tauto_step } with ~wps $ -. ( ( &W2 \/ &W3 ) \/ &W4 ) $ }
	$ ( &W1 -> ( -. if- ( &W2 , &W3 , &W4 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~notbii { apply ~df-ifp } } } { use tauto_step } with ~wps $ -. ( ( &W2 /\ &W3 ) \/ ( -. &W2 /\ &W4 ) ) $ }
	$ ( &W1 -> ( -. hadd ( &W2 , &W3 , &W4 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~notbii { apply ~df-had } } } { use tauto_step } with ~wps $ -. ( ( &W2 \/_ &W3 ) \/_ &W4 ) $ }
	$ ( &W1 -> ( -. cadd ( &W2 , &W3 , &W4 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~notbii { apply ~df-cad } } } { use tauto_step } with ~wps $ -. ( ( &W2 /\ &W3 ) \/ ( &W4 /\ ( &W2 \/_ &W3 ) ) ) $ }
	$ ( &W1 -> ( -. T. -> &W9 ) ) $
	{ apply ~a1i { apply ~pm2.24i { apply ~tru } } }
	$ ( &W1 -> ( -. F. -> &W9 ) ) $
	{ apply ~a1d { use tauto_step } }
	$ ( &W1 -> ( -. &W2 -> &W9 ) ) $
	{ try
		{ apply ~pm2.24d { use tauto_member } }
		{ apply ~ex { use tauto_step } }
	}
	// Cases of MM1's proveN
	$ ( &W1 -> ( ( &W2 -> &W3 ) -> &W9 ) ) $
	{ apply ~jad { use tauto_step } { use tauto_step } }
	$ ( &W1 -> ( ( &W2 /\ &W3 ) -> &W9 ) ) $
	{ apply ~impd { use tauto_step } }
	$ ( &W1 -> ( ( &W2 \/ &W3 ) -> &W9 ) ) $
	{ apply ~jaod { use tauto_step } { use tauto_step } }
	$ ( &W1 -> ( ( &W2 <-> &W3 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~dfbi3 } } { apply ~jaod { apply ~impd { use tauto_step } } { apply ~impd { use tauto_step } } } with ~wps $ ( ( &W2 /\ &W3 ) \/ ( -. &W2 /\ -. &W3 ) ) $ }
	$ ( &W1 -> ( ( &W2 -/\ &W3 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~df-nan } } { use tauto_step } with ~wps $ -. ( &W2 /\ &W3 ) $ }
	$ ( &W1 -> ( ( &W2 -\/ &W3 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~df-nor } } { use tauto_step } with ~wps $ -. ( &W2 \/ &W3 ) $ }
	$ ( &W1 -> ( ( &W2 \/_ &W3 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~excxor } } { apply ~jaod { apply ~impd { use tauto_step } } { apply ~impd { use tauto_step } } } with ~wps $ ( ( &W2 /\ -. &W3 ) \/ ( -. &W2 /\  &W3 ) ) $ }
	$ ( &W1 -> ( ( &W2 /\ &W3 /\ &W4 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~df-3an } } { apply ~impd { apply ~impd { use tauto_step } } } with ~wps $ ( ( &W2 /\ &W3 ) /\ &W4 ) $ }
	$ ( &W1 -> ( ( &W2 \/ &W3 \/ &W4 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~df-3or } } { apply ~jaod { apply ~jaod { use tauto_step } { use tauto_step } } { use tauto_step } } with ~wps $ ( ( &W2 \/ &W3 ) \/ &W4 ) $ }
	$ ( &W1 -> ( if- ( &W2 , &W3 , &W4 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~df-ifp } } { apply ~jaod { apply ~impd { use tauto_step } } { apply ~impd { use tauto_step } } } with ~wps $ ( ( &W2 /\ &W3 ) \/ ( -. &W2 /\ &W4 ) ) $ }
	$ ( &W1 -> ( hadd ( &W2 , &W3 , &W4 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~df-had } } { apply ~syl5 { apply ~biimpi { apply ~excxor } } { apply ~jaod { apply ~impd { use tauto_step } } { apply ~impd { use tauto_step } } } with ~wps $ ( ( ( &W2 \/_ &W3 ) /\ -. &W4 ) \/ ( -. ( &W2 \/_ &W3 ) /\  &W4 ) ) $ } with ~wps $ ( ( &W2 \/_ &W3 ) \/_ &W4 ) $ }
	$ ( &W1 -> ( cadd ( &W2 , &W3 , &W4 ) -> &W9 ) ) $
	{ apply ~syl5 { apply ~biimpi { apply ~df-cad } } { apply ~jaod { apply ~impd { use tauto_step } } { apply ~impd { use tauto_step } } } with ~wps $ ( ( &W2 /\ &W3 ) \/ ( &W4 /\ ( &W2 \/_ &W3 ) ) ) $ }
	$ ( &W1 -> ( T. -> &W9 ) ) $
	{ apply ~a1d { use tauto_step } }
	$ ( &W1 -> ( F. -> &W9 ) ) $
	{ apply ~a1i { apply ~falim } }
	$ ( &W1 -> ( &W2 -> &W9 ) ) $
	{ try
		{ apply ~pm2.21d { use tauto_member } }
		{ apply ~ex { use tauto_step } }
	}
}

// Proves a closed goal t: from `T. -> ( -. t -> F. )`, i.e. MM1's `tauto_start (proveP T. t F.)`.
tactics tauto ()
{ apply ~pm2.18i
	{ apply ~syl
		{ apply ~ax-mp { apply ~tru } { use tauto_step } with ~wph $ T. $ }
		{ apply ~falim }
		with ~wps $ F. $
	}
}

